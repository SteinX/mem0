# Copy to .env and fill in real values.

COMPOSE_PROJECT_NAME=mem0-dev

# Build contexts are read by the machine running docker compose.
MEM0_UPSTREAM_BUILD_CONTEXT=../upstream
MEM0_SERVER_IMAGE=ghcr.io/steinx/mem0:v2.2.1-steinx.1
MEM0_MCP_BUILD_CONTEXT=../mem0-oss-mcp
MEM0_MCP_IMAGE=ghcr.io/steinx/mem0-oss-mcp:0.1.5

# Release images.
MEM0_DASHBOARD_IMAGE=ghcr.io/steinx/mem0-dashboard-sidecar:v0.3.11
MEM0_SIDECAR_IMAGE=ghcr.io/steinx/mem0-platform-sidecar:v0.3.11

# Bind mount paths are read by the Docker daemon on the Unraid host.
MEM0_SERVER_HOST_DIR=/mnt/user/appdata/mem0/upstream/server
MEM0_HISTORY_HOST_DIR=/mnt/user/appdata/mem0/history
MEM0_POSTGRES_HOST_DIR=/mnt/user/appdata/mem0/postgres-data
MEM0_SIDECAR_HOST_DIR=/mnt/user/appdata/mem0/sidecar-data

# Host ports.
MEM0_API_HOST_PORT=38888
MEM0_DASHBOARD_HOST_PORT=33000
MEM0_POSTGRES_HOST_PORT=38432
MEM0_MCP_HOST_PORT=38080
MEM0_SIDECAR_ROLLBACK_HOST_PORT=38765
MEM0_INGRESS_CANARY_API_HOST_PORT=38889
MEM0_INGRESS_CANARY_MCP_HOST_PORT=38082
MEM0_CORE_ROLLBACK_HOST_PORT=38890
MEM0_MCP_ROLLBACK_HOST_PORT=38083

# Public URLs used by the dashboard/API.
MEM0_DASHBOARD_URL=http://localhost:33000
MEM0_PUBLIC_API_URL=http://localhost:38888
MEM0_INSTANCE_NAME=Mem0
SIDECAR_INTERNAL_API_URL=http://mem0-platform-sidecar:8765
SIDECAR_PROJECT_ID=default
# Use * to show every app in this project in the Dashboard memories explorer.
SIDECAR_APP_ID=*

# Auth and database.
ADMIN_API_KEY=replace-with-long-random-value
JWT_SECRET=replace-with-long-random-value
AUTH_DISABLED=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# Model providers.
OPENAI_API_KEY=replace-with-openai-compatible-key
OPENAI_BASE_URL=https://api.openai.com/v1
MEM0_DEFAULT_LLM_MODEL=gpt-5.4-mini
MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3

# MCP bridge auth.
# disabled | static | hybrid | core_api_key
MEM0_OSS_MCP_AUTH_MODE=core_api_key
MEM0_OSS_MCP_CLIENT_AUTH_URL=http://mem0:8000/auth/me
MEM0_OSS_MCP_CLIENT_AUTH_TIMEOUT_SECONDS=5
# Required by static and hybrid. Omit from the MCP container after a verified
# core_api_key cutover; retain it only in the protected rollback secret store.
MEM0_OSS_MCP_TOKEN=
# Independent canary client credential. In core_api_key mode this is a named
# Core API key, while MEM0_OSS_MCP_TOKEN above may remain empty.
MEM0_CANARY_MCP_TOKEN=replace-with-canary-client-key
# core_api_key for normal/cutover checks; legacy_static only during rollback.
MEM0_CANARY_EXPECTED_CREDENTIAL_KIND=core_api_key
MEM0_OSS_DEFAULT_USER_ID=codex
MEM0_OSS_DEFAULT_APP_ID=codex
MEM0_OSS_TIMEOUT=30
MEM0_SIDECAR_REQUIRED=true
MEM0_SIDECAR_INSTANCE_ID=mem0-oss-mcp
MEM0_SIDECAR_HEARTBEAT_INTERVAL_SECONDS=300

# Platform sidecar.
MEM0_SIDECAR_DATABASE_URL=sqlite:////data/mem0_sidecar.sqlite3
MEM0_SIDECAR_MEM0_BASE_URL=http://mem0:8000
MEM0_SIDECAR_MEM0_API_KEY_HEADER_NAME=X-API-Key
MEM0_SIDECAR_MEM0_API_KEY_PREFIX=
MEM0_SIDECAR_MEM0_EXTRA_HEADERS={}
MEM0_SIDECAR_MEM0_REQUEST_TIMEOUT_SECONDS=30
MEM0_SIDECAR_MEM0_CONNECT_TIMEOUT_SECONDS=30
MEM0_SIDECAR_MEM0_VERIFY_TLS=true
MEM0_SIDECAR_MEM0_CA_BUNDLE=
MEM0_SIDECAR_MEM0_MEMORIES_PATH=/memories
MEM0_SIDECAR_MEM0_SEARCH_PATH=/search
# docker-compose.unraid.yaml maps SIDECAR_PROJECT_ID above into the sidecar.
MEM0_SIDECAR_CLIENT_AUTH_ENABLED=true
MEM0_SIDECAR_CLIENT_AUTH_PATH=/auth/me
MEM0_SIDECAR_CLIENT_AUTH_TIMEOUT_SECONDS=5
MEM0_SIDECAR_CLIENT_AUTH_ALLOW_BOOTSTRAP_ADMIN=true
MEM0_SIDECAR_ALLOW_ADOPT_UNSCOPED=false
MEM0_SIDECAR_DIRECT_WRITE_SYNC_ENABLED=true
MEM0_SIDECAR_DIRECT_WRITE_SYNC_INTERVAL_SECONDS=60
MEM0_SIDECAR_DIRECT_WRITE_SYNC_SCAN_LIMIT=5000
MEM0_SIDECAR_DIRECT_WRITE_SYNC_LEGACY_CAP=1000
MEM0_SIDECAR_DIRECT_WRITE_SYNC_DEFAULT_APP_ID=default
# Default off for a fresh deployment. Enable only after policies are configured
# in OBSERVE and a fresh full-routing MCP heartbeat is visible.
MEM0_SIDECAR_CONSOLIDATION_ENABLED=false
MEM0_SIDECAR_CONSOLIDATION_HARD_DELETE_ENABLED=false
MEM0_SIDECAR_CONSOLIDATION_SCHEDULER_INTERVAL_SECONDS=300
MEM0_SIDECAR_CONSOLIDATION_JOB_LEASE_SECONDS=300
MEM0_SIDECAR_CONSOLIDATION_BRIDGE_ROUTING_REQUIRED=true
MEM0_SIDECAR_LOG_LEVEL=INFO
MEM0_SIDECAR_LOG_FORMAT=json
MEM0_SIDECAR_REQUEST_ID_HEADER=X-Request-ID

MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30
AGENT_SHARED_NETWORK=agent-shared
MEM0_NETWORK_NAME=mem0-dev_mem0_network
